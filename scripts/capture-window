#!/bin/bash
# Describe one live window well enough to open it again later.
#
#   capture-window <address>   -> one JSON object on stdout, or nothing
#
# It has to run while the window is alive. Hyprland's closewindow event carries
# only an address: by the time a window is gone its process is gone with it, and
# /proc has nothing left to read. So the shell watching those events captures
# every window as it opens and keeps the result until it is needed.
#
# The reconstruction rules are the ones Workspace Presets arrived at the hard
# way, and they are copied rather than shared: two marketplace plugins that
# depend on each other's files are two plugins that break separately.

set -uo pipefail

ADDRESS="${1:-}"
[[ -n $ADDRESS ]] || exit 1
# The event socket reports addresses without the 0x that hyprctl writes.
[[ $ADDRESS == 0x* ]] || ADDRESS="0x$ADDRESS"

client=$(hyprctl clients -j 2>/dev/null | jq -c --arg a "$ADDRESS" '.[] | select(.address == $a)') || exit 1
[[ -n $client ]] || exit 1

pid=$(jq -r '.pid' <<<"$client")
[[ -n $pid && -r /proc/$pid/cmdline ]] || exit 1

# What a window was running comes back as one string, because that is what
# hl.dsp.exec_cmd takes and it hands the string to a shell. So every argument
# read out of /proc is quoted the moment it is picked up, and stays quoted:
# a window whose command line holds a semicolon or a backtick — a filename is
# enough — would otherwise run it as a command the next time the window is
# reopened. Nothing here builds a command string by joining raw argv.
quote() {
  local out=() arg
  for arg in "$@"; do out+=("$(printf '%q' "$arg")"); done
  printf '%s' "${out[*]}"
}

# The inverse. Safe because the only thing ever evaluated is what quote() wrote:
# the arguments come back as themselves, not as shell to run.
unquote() { eval "set -- $1"; printf '%s\0' "$@"; }

argv_of() {
  local out=() arg
  while IFS= read -r -d '' arg; do out+=("$arg"); done < <(unquote "$1")
  printf '%s\0' "${out[@]}"
}

binary_of() {
  local first
  IFS= read -r -d '' first < <(unquote "$1") || return 1
  printf '%s' "$first"
}

# A single-instance app's /proc entry belongs to its daemon, and a daemon is
# started with the flags that tell it not to put a window on screen.
strip_daemon_flags() {
  local out=() arg
  while IFS= read -r -d '' arg; do
    case "$arg" in
      --initial-window=false | --gtk-single-instance=*) continue ;;
    esac
    out+=("$arg")
  done
  quote "${out[@]}"
}

strip_working_dir() {
  local out=() skip=false arg
  while IFS= read -r -d '' arg; do
    if [[ $skip == true ]]; then skip=false; continue; fi
    case "$arg" in
      --working-directory | --directory | --cwd | -D) skip=true; continue ;;
      --working-directory=* | --directory=* | --cwd=*) continue ;;
    esac
    out+=("$arg")
  done < <(argv_of "$1")
  quote "${out[@]}"
}

strip_exec_flag() { printf '%s' "${1%% -e *}"; }

# Only the directory flag differs between terminals; -e is common ground, since
# ghostty and alacritty implement it and foot accepts it for xterm compatibility.
# An unrecognised terminal is captured without a directory rather than guessed at.
working_directory_flag() {
  case "${1##*/}" in
    ghostty | foot) printf -- '--working-directory=%s' "$(printf '%q' "$2")" ;;
    alacritty) printf -- '--working-directory %s' "$(printf '%q' "$2")" ;;
    *) return 1 ;;
  esac
}

browser_config_dir() {
  case "${1##*/}" in
    chromium | chromium-browser) printf '%s/.config/chromium' "$HOME" ;;
    google-chrome | google-chrome-stable | chrome) printf '%s/.config/google-chrome' "$HOME" ;;
    brave | brave-browser) printf '%s/.config/BraveSoftware/Brave-Browser' "$HOME" ;;
    microsoft-edge | microsoft-edge-stable) printf '%s/.config/microsoft-edge' "$HOME" ;;
    vivaldi | vivaldi-stable) printf '%s/.config/vivaldi' "$HOME" ;;
    *) return 1 ;;
  esac
}

# A browser with several profiles and no profile flag opens the chooser instead
# of a browser, which stops the reopen dead.
add_profile_flag() {
  local cmd="$1" binary config state profile count
  binary=$(binary_of "$1") || { printf '%s' "$cmd"; return; }
  case "$cmd" in *--profile-directory=* | *" -P "*) printf '%s' "$cmd"; return ;; esac

  config=$(browser_config_dir "$binary") || { printf '%s' "$cmd"; return; }
  state="$config/Local State"
  [[ -r $state ]] || { printf '%s' "$cmd"; return; }

  count=$(jq '.profile.info_cache | length' "$state" 2>/dev/null || echo 0)
  [[ ${count:-0} -gt 1 ]] || { printf '%s' "$cmd"; return; }
  profile=$(jq -r '.profile.last_used // empty' "$state" 2>/dev/null)
  [[ -n $profile ]] || { printf '%s' "$cmd"; return; }
  printf '%s --profile-directory=%s' "$cmd" "$(printf '%q' "$profile")"
}

# A browser keeps every window in one process, so its command line is whatever
# the browser was first started with — including URLs from a launch that has
# nothing to do with the window being closed now. Replaying that reopens a
# stranger's page. The address of the actual page is nowhere readable, so the
# honest reopen is a fresh window and nothing more.
# Which profile directory the command names, so the right session file is read.
# The name can contain a space — "Profile 4" — so it is read back as an argument
# rather than picked out of the string by word splitting.
profile_of() {
  local arg
  while IFS= read -r -d '' arg; do
    case "$arg" in --profile-directory=*) printf '%s' "${arg#*=}"; return ;; esac
  done < <(argv_of "$1")
  printf 'Default'
}

as_browser() {
  local cmd="$1" title="$2" binary out=() arg
  binary=$(binary_of "$1") || { printf '%s' "$cmd"; return; }
  case "${binary##*/}" in
    chromium | chromium-browser | google-chrome* | chrome | brave* | microsoft-edge* | vivaldi* | firefox*) ;;
    *) printf '%s' "$cmd"; return ;;
  esac

  while IFS= read -r -d '' arg; do
    case "$arg" in
      http://* | https://* | file://* | about:*) continue ;;
      --new-window) continue ;;
    esac
    out+=("$arg")
  done < <(argv_of "$1")

  # Every tab, in order, on one command line: a browser handed several URLs
  # opens them as tabs in the window it was told to make.
  local tabs=() url
  while IFS= read -r url; do
    [[ -n $url ]] && tabs+=("$url")
  done < <(browser_tabs_for "$title" "$(browser_config_dir "$binary")/$(profile_of "$cmd")")

  quote "${out[@]}" "--new-window" "${tabs[@]}"
}

# The page a browser window was on is not on any command line — but Chromium
# writes its session to disk, and that file says which tabs belong to which
# window. scripts/browser-tabs reads it, so a window comes back whole instead of
# empty. Without python3 it prints nothing and the window comes back empty, as
# it did before.
browser_tabs_for() {
  local title="$1" config="$2"
  command -v python3 >/dev/null 2>&1 || return 1
  [[ -n $config && -d $config ]] || return 1
  "$(dirname "${BASH_SOURCE[0]}")/browser-tabs" "$config" "$title" 2>/dev/null
}

# Claude Code keeps its conversations per directory, so --continue reopens the
# one that window was in rather than a blank session.
# Takes the argv of what was running inside the terminal and returns it quoted.
as_command() {
  case "${1##*/}" in
    claude) printf 'claude --continue'; return ;;
  esac
  quote "$@"
}

# Only a terminal has a session inside it. Every other app has children too —
# Electron keeps a pile of them — and treating those as "what the window was
# running" turns a browser into a command line full of zygote helpers.
is_terminal() {
  local pid="$1" cmd="$2" child comm
  for child in $(pgrep -P "$pid" 2>/dev/null); do
    comm=$(cat "/proc/$child/comm" 2>/dev/null) || continue
    case "$comm" in bash | zsh | fish | sh | nu | dash | ksh) return 0 ;; esac
  done
  # A window this plugin reopened runs its command instead of a shell.
  [[ $cmd == *" -e "* ]] && return 0
  return 1
}

# A terminal runs every window in one process, so /proc cannot say which window
# is in which directory. Here it does not have to: one address is being asked
# about, and the shell whose window title matches is the one inside it.
session_for() {
  local root_pid="$1" title="$2" head pid comm dir child cmdline
  head="${title%% *}"; head="${head##*/}"

  for pid in $(pgrep -P "$root_pid" 2>/dev/null); do
    comm=$(cat "/proc/$pid/comm" 2>/dev/null) || continue
    dir=$(readlink "/proc/$pid/cwd" 2>/dev/null) || continue
    [[ -n $dir && -d $dir ]] || continue

    local matched=false
    case "$comm" in
      bash | zsh | fish | sh | nu | dash | ksh)
        for child in $(pgrep -P "$pid" 2>/dev/null); do
          [[ "$(cat "/proc/$child/comm" 2>/dev/null)" == "$head" ]] && matched=true
        done
        case "$title" in
          "~") [[ $dir == "$HOME" ]] && matched=true ;;
          "~/"*) [[ $dir == "$HOME/${title#\~/}" ]] && matched=true ;;
          *)
            local suffix="${title%% *}"; suffix="${suffix#…}"; suffix="${suffix#/}"
            [[ -n $suffix && ($dir == *"/$suffix" || $dir == "$suffix") ]] && matched=true
            ;;
        esac
        ;;
      *)
        # A window opened as `-e command` has no shell inside it, only the
        # command — and it is the only thing in there.
        matched=true
        ;;
    esac
    [[ $matched == true ]] || continue

    # Read as arguments, never as a line of text: this is the second way an
    # attacker-chosen string could reach a shell, and it is a program's own
    # argv, which is under no obligation to be free of shell syntax.
    local run="" inner=()
    case "$comm" in
      bash | zsh | fish | sh | nu | dash | ksh)
        for child in $(pgrep -P "$pid" 2>/dev/null); do
          inner=()
          while IFS= read -r -d '' cmdline; do inner+=("$cmdline"); done <"/proc/$child/cmdline"
          ((${#inner[@]})) && break
        done
        ;;
      *)
        while IFS= read -r -d '' cmdline; do inner+=("$cmdline"); done <"/proc/$pid/cmdline"
        ;;
    esac
    ((${#inner[@]})) && run=$(as_command "${inner[@]}")

    printf '%s\t%s' "$dir" "$run"
    return 0
  done
  return 1
}

# Some launchers hand the kernel one argument with the whole command line inside
# it — /proc says argv[0] is "/opt/thing/App --show" and there is no argv[1].
# Quoting that faithfully produces a path no file has. It is only split when the
# whole thing is not a program and its first word is, so splitting can never
# turn a real filename with a space in it into two arguments. The split is on
# whitespace alone; the pieces are quoted again immediately.
split_packed_argv() {
  local args=() arg
  while IFS= read -r -d '' arg; do args+=("$arg"); done < <(argv_of "$1")
  ((${#args[@]} == 1)) || { printf '%s' "$1"; return; }
  [[ ${args[0]} == *[[:space:]]* && ! -x ${args[0]} ]] || { printf '%s' "$1"; return; }

  local head="${args[0]%%[[:space:]]*}"
  [[ -x $head ]] || { printf '%s' "$1"; return; }
  read -ra args <<<"${args[0]}"
  quote "${args[@]}"
}

cmd=$(strip_daemon_flags <"/proc/$pid/cmdline")
[[ -n $cmd ]] || exit 1
cmd=$(split_packed_argv "$cmd")
cmd=$(strip_exec_flag "$cmd")
cmd=$(strip_working_dir "$cmd")
title=$(jq -r '.title' <<<"$client")

cmd=$(add_profile_flag "$cmd")
cmd=$(as_browser "$cmd" "$title")
raw_cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null)

if is_terminal "$pid" "$raw_cmdline" && session=$(session_for "$pid" "$title"); then
  dir="${session%%$'\t'*}"
  run="${session#*$'\t'}"
  if flag=$(working_directory_flag "$(binary_of "$cmd")" "$dir"); then
    cmd="$cmd $flag"
  fi
  [[ -n $run ]] && cmd="$cmd -e $run"
fi

jq -n -c \
  --arg address "$ADDRESS" \
  --arg cmd "$cmd" \
  --arg class "$(jq -r '.class' <<<"$client")" \
  --arg title "$title" \
  --argjson workspace "$(jq '.workspace.id' <<<"$client")" \
  --argjson floating "$(jq '.floating' <<<"$client")" \
  --arg at "$(jq -r '.at | join(",")' <<<"$client")" \
  --arg size "$(jq -r '.size | join(",")' <<<"$client")" \
  '{address: $address, cmd: $cmd, class: $class, title: $title,
    workspace: $workspace, floating: $floating, at: $at, size: $size}'
