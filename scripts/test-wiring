#!/usr/bin/env node
// Every root.something() the panel calls must exist as a function on the panel.
//
// This exists because it did not. A rewrite of one block silently swallowed
// four functions, and two menu actions became TypeErrors that only showed up in
// the shell log — the buttons looked fine and did nothing. qmllint does not
// catch it: the call is legal QML, it just fails at the moment you click.

const fs = require("fs")
const path = require("path")

const root = path.join(__dirname, "..")
let failures = 0

function check(label, ok, detail) {
  if (!ok) failures++
  console.log(`${ok ? "ok  " : "FAIL"} ${label}`)
  if (!ok && detail) console.log(`     ${detail}`)
}

for (const file of ["Panel.qml", "BarWidget.qml", "Service.qml"]) {
  const source = fs.readFileSync(path.join(root, file), "utf8")

  const defined = new Set(
    [...source.matchAll(/^\s*function\s+([A-Za-z_$][\w$]*)\s*\(/gm)].map(m => m[1])
  )
  // Properties are callable-looking too when they hold a value, but a call
  // needs a function; property reads are filtered out by the "(" in the match.
  const called = new Set(
    [...source.matchAll(/\broot\.([A-Za-z_$][\w$]*)\s*\(/g)].map(m => m[1])
  )

  // Inherited from qs.Ui.Panel, which the QML type extends.
  const inherited = new Set(["open", "close", "toggle", "closeForPopoutSwitch", "setting"])
  const missing = [...called].filter(name => !defined.has(name) && !inherited.has(name)).sort()
  check(`${file}: every root.x() it calls is defined`, missing.length === 0,
    missing.length ? `missing: ${missing.join(", ")}` : "")
}

// Every name the test harness exports has to exist in Model.js. This is here
// because the same function was cut twice by the same careless slice of a span
// between two others, and both times the failure was a stack trace rather than
// a test.
const harness = fs.readFileSync(path.join(root, "scripts/test-model"), "utf8")
const exported = (harness.match(/Object\.assign\(exports, \{([^}]*)\}/) || [, ""])[1]
  .split(",").map(s => s.trim()).filter(Boolean)
const modelSource = fs.readFileSync(path.join(root, "Model.js"), "utf8")
const inModel = new Set(
  [...modelSource.matchAll(/^function\s+([A-Za-z_$][\w$]*)\s*\(/gm)].map(m => m[1])
)
const gone = exported.filter(name => !inModel.has(name))
check("every function the tests export exists in Model.js", gone.length === 0,
  gone.length ? `missing: ${gone.join(", ")}` : "")

process.exit(failures === 0 ? 0 : 1)
